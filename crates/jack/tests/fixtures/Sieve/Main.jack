class Main {
    static Sieve sieve;

    function void main() {
        var Array ps;
        var int i;
        let sieve = Sieve.new(100);
        let ps = sieve.primes();
        let i = 1;
        while (i < (ps[0] + 1)) {
            do Output.printInt(ps[i]);
            do Output.printChar(44);
            let i = i + 1;
        }
        let ps[ps[0]] = ps[1] + ps[ps[0] - 1];
        do ps.dispose();
        do sieve.dispose();
        return;
    }
}
